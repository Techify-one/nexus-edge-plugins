{
  "openapi": "3.1.0",
  "info": {
    "title": "Nexus Asaas API",
    "version": "1.2.1",
    "description": "Private Nexus gateway for a personal Asaas account."
  },
  "paths": {
    "/api/v1/p/asaas/balance": {
      "get": {
        "summary": "Read the available Asaas balance",
        "responses": {
          "200": {
            "description": "Available balance"
          }
        },
        "x-nexus-mcp": {
          "name": "asaas_get_balance",
          "permissions": ["asaas.balance.read"],
          "readOnly": true,
          "destructive": false,
          "titles": {
            "en": "Read the available Asaas balance",
            "pt-BR": "Consultar saldo disponível no Asaas"
          }
        }
      }
    },
    "/api/v1/p/asaas/statement": {
      "get": {
        "summary": "Read the paginated Asaas statement",
        "parameters": [
          {
            "in": "query",
            "name": "startDate",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "finishDate",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "in": "query",
            "name": "order",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statement entries"
          }
        },
        "x-nexus-mcp": {
          "name": "asaas_get_statement",
          "permissions": ["asaas.statement.read"],
          "readOnly": true,
          "destructive": false,
          "titles": {
            "en": "Read the paginated Asaas statement",
            "pt-BR": "Consultar extrato do Asaas"
          }
        }
      }
    },
    "/api/v1/p/asaas/connection": {
      "get": {
        "summary": "Test the configured API key with a balance read",
        "responses": {
          "200": {
            "description": "Connection accepted"
          }
        },
        "x-nexus-mcp": {
          "name": "asaas_get_connection",
          "permissions": ["asaas.settings.read"],
          "readOnly": true,
          "destructive": false,
          "titles": {
            "en": "Test the configured API key with a balance read",
            "pt-BR": "Verificar conexão com o Asaas"
          }
        }
      }
    },
    "/api/v1/p/asaas/connection/validate": {
      "post": {
        "summary": "Validate a production API key before saving it",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["apiKey"],
                "properties": {
                  "apiKey": {
                    "type": "string",
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Key accepted by Asaas"
          }
        }
      }
    },
    "/api/v1/p/asaas/pix/address-keys/inspect": {
      "post": {
        "summary": "Resolve the Pix recipient before transfer confirmation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pixAddressKey", "pixAddressKeyType"],
                "properties": {
                  "pixAddressKey": {
                    "type": "string"
                  },
                  "pixAddressKeyType": {
                    "type": "string",
                    "enum": ["CPF", "CNPJ", "EMAIL", "PHONE", "EVP"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Masked recipient identity"
          }
        },
        "x-nexus-mcp": {
          "name": "asaas_post_pix_address_keys_inspect",
          "permissions": ["asaas.pix.create"],
          "readOnly": true,
          "destructive": false,
          "titles": {
            "en": "Resolve the Pix recipient before transfer confirmation",
            "pt-BR": "Consultar destinatário de Pix"
          }
        }
      }
    },
    "/api/v1/p/asaas/pix/transfers": {
      "get": {
        "summary": "List Pix transfers initiated through Nexus",
        "responses": {
          "200": {
            "description": "Local Pix transfer history"
          }
        },
        "x-nexus-mcp": {
          "name": "asaas_get_pix_transfers",
          "permissions": ["asaas.pix.read"],
          "readOnly": true,
          "destructive": false,
          "titles": {
            "en": "List Pix transfers initiated through Nexus",
            "pt-BR": "Listar transferências Pix"
          }
        }
      },
      "post": {
        "summary": "Submit a Pix transfer to an external key",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 120
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "value",
                  "pixAddressKey",
                  "pixAddressKeyType",
                  "confirmed"
                ],
                "properties": {
                  "value": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "pixAddressKey": {
                    "type": "string"
                  },
                  "pixAddressKeyType": {
                    "type": "string",
                    "enum": ["CPF", "CNPJ", "EMAIL", "PHONE", "EVP"]
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "confirmed": {
                    "type": "boolean",
                    "const": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pix submitted to Asaas"
          }
        },
        "x-nexus-mcp": {
          "name": "asaas_post_pix_transfers",
          "permissions": ["asaas.pix.create"],
          "readOnly": false,
          "destructive": true,
          "titles": {
            "en": "Submit a Pix transfer to an external key",
            "pt-BR": "Enviar Pix para uma chave externa"
          }
        }
      }
    },
    "/api/v1/p/asaas/pix/transfers/{id}": {
      "get": {
        "summary": "Refresh a Pix transfer status from Asaas",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current transfer status"
          }
        },
        "x-nexus-mcp": {
          "name": "asaas_get_pix_transfers_id",
          "permissions": ["asaas.pix.read"],
          "readOnly": true,
          "destructive": false,
          "titles": {
            "en": "Refresh a Pix transfer status from Asaas",
            "pt-BR": "Atualizar situação de um Pix"
          }
        }
      }
    },
    "/api/v1/public/p/asaas/withdrawal-authorization": {
      "post": {
        "summary": "Authorize an Asaas withdrawal previously registered by Nexus",
        "parameters": [
          {
            "in": "header",
            "name": "asaas-access-token",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "transfer"],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "TRANSFER"
                  },
                  "transfer": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "APPROVED or REFUSED decision"
          },
          "401": {
            "description": "Webhook token rejected"
          }
        }
      }
    }
  }
}
