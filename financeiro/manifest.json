{
  "manifestVersion": 2,
  "packageFormat": 2,
  "id": "financeiro",
  "name": "Financeiro",
  "description": "Company finances, receivables, payables, recurring entries and monthly closing.",
  "publisher": {
    "id": "techify",
    "name": "Techify"
  },
  "version": "1.0.1",
  "apiVersion": 1,
  "coreMinVersion": "1.1.0-beta.15",
  "compatibilityDate": "2026-09-15",
  "compatibilityFlags": ["nodejs_compat"],
  "databaseDialects": ["d1", "postgres"],
  "tablePrefix": "financeiro_",
  "engines": {
    "hostApi": 1,
    "coreApi": 1
  },
  "frontend": {
    "entry": "frontend/entry.js",
    "styles": ["frontend/styles.css"],
    "isolation": "light",
    "routes": [
      {
        "routeKey": "financeiro.resumo",
        "path": "/app/p/financeiro"
      },
      {
        "routeKey": "financeiro.lancamentos",
        "path": "/app/p/financeiro/lancamentos"
      },
      {
        "routeKey": "financeiro.recorrencias",
        "path": "/app/p/financeiro/recorrencias"
      },
      {
        "routeKey": "financeiro.cadastros",
        "path": "/app/p/financeiro/cadastros"
      },
      {
        "routeKey": "financeiro.transferencias",
        "path": "/app/p/financeiro/transferencias"
      },
      {
        "routeKey": "financeiro.fechamento",
        "path": "/app/p/financeiro/fechamento"
      },
      {
        "routeKey": "financeiro.auditoria",
        "path": "/app/p/financeiro/auditoria"
      },
      {
        "routeKey": "financeiro.configuracoes",
        "path": "/app/p/financeiro/configuracoes"
      }
    ]
  },
  "resources": [
    {
      "name": "documents",
      "type": "r2",
      "binding": "DOCUMENTS",
      "capabilityVersion": 1,
      "required": true,
      "retention": "preserve",
      "configuration": {}
    },
    {
      "name": "scheduler",
      "type": "durable_object",
      "binding": "SCHEDULER",
      "capabilityVersion": 1,
      "required": true,
      "retention": "preserve",
      "configuration": {
        "className": "FinanceiroScheduler",
        "storage": "sqlite"
      }
    }
  ],
  "secrets": [
    {
      "name": "TELEGRAM_BOT_TOKEN",
      "label": "Telegram bot token",
      "required": false,
      "permission": "financeiro.avisos.manage"
    },
    {
      "name": "FINANCEIRO_WEBHOOK_SECRET",
      "label": "Financial webhook signing secret (at least 32 bytes)",
      "required": false,
      "permission": "financeiro.avisos.manage"
    },
    {
      "name": "FINANCEIRO_WEBHOOK_URL",
      "label": "Trusted financial webhook HTTPS destination",
      "required": false,
      "permission": "financeiro.avisos.manage"
    },
    {
      "name": "FINANCEIRO_WEBHOOK_ALLOWED_HOSTS",
      "label": "Exact trusted public webhook hostnames",
      "required": false,
      "permission": "financeiro.avisos.manage"
    }
  ],
  "permissions": [
    "financeiro.empresas.read",
    "financeiro.empresas.create",
    "financeiro.empresas.update",
    "financeiro.contas.read",
    "financeiro.contas.create",
    "financeiro.contas.update",
    "financeiro.categorias.read",
    "financeiro.categorias.create",
    "financeiro.categorias.update",
    "financeiro.lancamentos.read",
    "financeiro.lancamentos.create",
    "financeiro.lancamentos.update",
    "financeiro.lancamentos.cancel",
    "financeiro.movimentos.read",
    "financeiro.movimentos.create",
    "financeiro.movimentos.reverse",
    "financeiro.transferencias.read",
    "financeiro.transferencias.create",
    "financeiro.transferencias.reverse",
    "financeiro.recorrencias.read",
    "financeiro.recorrencias.create",
    "financeiro.recorrencias.update",
    "financeiro.recorrencias.generate",
    "financeiro.fechamentos.read",
    "financeiro.fechamentos.close",
    "financeiro.fechamentos.reopen",
    "financeiro.resumo.read",
    "financeiro.relatorios.read",
    "financeiro.visoes.read",
    "financeiro.visoes.create",
    "financeiro.visoes.delete",
    "financeiro.auditoria.read",
    "financeiro.anexos.read",
    "financeiro.anexos.create",
    "financeiro.anexos.delete",
    "financeiro.avisos.read",
    "financeiro.avisos.manage"
  ],
