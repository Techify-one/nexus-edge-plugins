{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "app-plugin-financeiro",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "DATABASE_PROVIDER": "d1" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "financeiro-local",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations/d1",
    },
  ],
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "financeiro-local-documents" },
  ],
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULER", "class_name": "FinanceiroScheduler" }],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FinanceiroScheduler"] },
  ],
}
