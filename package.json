{
  "name": "@techify/nexus-edge-plugins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "pnpm --filter @nexus/plugin-sdk build && pnpm --filter './plugins/**' --workspace-concurrency=1 build",
    "package": "pnpm --filter './plugins/**' --workspace-concurrency=1 package",
    "marketplace": "pnpm --filter @nexus/plugin-sdk build && nexus-marketplace-generate",
    "verify:packages": "node scripts/verify-packages.mjs",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nexus/plugin-sdk": "workspace:*",
    "@casl/ability": "7.0.1",
    "@casl/react": "7.0.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "9.1.2",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.26.1",
    "@cloudflare/workers-types": "5.20260908.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.0",
    "fflate": "0.8.3",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
