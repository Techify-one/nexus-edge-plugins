{
  "manifestVersion": 2,
  "packageFormat": 2,
  "id": "crm",
  "name": "CRM",
  "description": "Customer relationship management with leads and activities.",
  "publisher": { "id": "techify", "name": "Techify" },
  "version": "2.0.3",
  "apiVersion": 1,
  "coreMinVersion": "1.1.0-beta.8",
  "compatibilityDate": "2026-09-09",
  "compatibilityFlags": ["nodejs_compat"],
  "databaseDialects": ["d1", "postgres"],
  "tablePrefix": "crm_",
  "engines": { "hostApi": 1, "coreApi": 1 },
  "frontend": {
    "entry": "frontend/entry.js",
    "styles": ["frontend/styles.css"],
    "isolation": "light",
    "routes": [
      { "routeKey": "crm.home", "path": "/app/p/crm" },
      { "routeKey": "crm.leads", "path": "/app/p/crm/leads" }
    ]
  },
  "localizedMetadata": {
    "pt-BR": {
      "name": "CRM",
      "description": "Gestão de leads e atividades comerciais.",
      "menuTitles": { "crm.home": "CRM", "crm.leads": "Leads" },
      "permissionLabels": {
        "crm.lead.read": "Visualizar leads",
        "crm.lead.create": "Criar leads",
        "crm.lead.update": "Editar leads",
        "crm.lead.delete": "Excluir leads"
      }
    },
    "en": {
      "name": "CRM",
      "description": "Lead and sales activity management.",
      "menuTitles": { "crm.home": "CRM", "crm.leads": "Leads" },
      "permissionLabels": {
        "crm.lead.read": "View leads",
        "crm.lead.create": "Create leads",
        "crm.lead.update": "Edit leads",
        "crm.lead.delete": "Delete leads"
      }
    }
  },
  "permissions": [
    "crm.lead.read",
    "crm.lead.create",
    "crm.lead.update",
    "crm.lead.delete"
  ],
  "menu": [
    { "title": "CRM", "routeKey": "crm.home", "path": "/app/p/crm" },
    {
      "title": "Leads",
      "routeKey": "crm.leads",
      "path": "/app/p/crm/leads"
    }
  ]
}
