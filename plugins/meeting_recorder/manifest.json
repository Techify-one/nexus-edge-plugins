{
  "manifestVersion": 2,
  "packageFormat": 2,
  "id": "meeting_recorder",
  "name": "Meeting Recorder",
  "description": "Record, upload and transcribe meetings with optional Telegram ingestion.",
  "publisher": { "id": "techify", "name": "Techify" },
  "version": "2.0.0",
  "apiVersion": 1,
  "coreMinVersion": "1.1.0-beta.8",
  "compatibilityDate": "2026-09-09",
  "compatibilityFlags": ["nodejs_compat"],
  "databaseDialects": ["d1", "postgres"],
  "tablePrefix": "meeting_recorder_",
  "engines": { "hostApi": 1, "coreApi": 1 },
  "frontend": {
    "entry": "frontend/entry.js",
    "styles": ["frontend/styles.css"],
    "isolation": "light",
    "persistentSurface": true,
    "routes": [
      {
        "routeKey": "meeting_recorder.home",
        "path": "/app/p/meeting_recorder"
      },
      {
        "routeKey": "meeting_recorder.new",
        "path": "/app/p/meeting_recorder/new"
      },
      {
        "routeKey": "meeting_recorder.settings",
        "path": "/app/p/meeting_recorder/settings"
      },
      {
        "routeKey": "meeting_recorder.detail",
        "path": "/app/p/meeting_recorder/:recordingId"
      }
    ]
  },
  "publicRoutes": ["/telegram/webhook"],
  "secrets": [
    {
      "name": "TELEGRAM_BOT_TOKEN",
      "label": "Telegram bot token",
      "required": false,
      "permission": "meeting_recorder.settings.update"
    },
    {
      "name": "TELEGRAM_WEBHOOK_SECRET",
      "label": "Telegram webhook secret",
      "required": false,
      "permission": "meeting_recorder.settings.update"
    }
  ],
  "resources": [
    {
      "name": "ai",
      "capabilityVersion": 1,
      "type": "ai",
      "binding": "AI",
      "required": true,
      "retention": "preserve",
      "configuration": {}
    },
    {
      "name": "storage",
      "capabilityVersion": 1,
      "type": "r2",
      "binding": "STORAGE",
      "required": false,
      "retention": "preserve",
      "configuration": {}
    }
  ],
  "localizedMetadata": {
    "pt-BR": {
      "name": "Gravador de reuniões",
      "description": "Gravação, upload e transcrição de reuniões.",
      "menuTitles": {
        "meeting_recorder.home": "Gravador de reuniões"
      }
    },
    "en": {
      "name": "Meeting Recorder",
      "description": "Meeting recording, upload and transcription.",
      "menuTitles": {
        "meeting_recorder.home": "Meeting Recorder"
      }
    }
  },
  "permissions": [
    "meeting_recorder.recording.read",
    "meeting_recorder.recording.create",
    "meeting_recorder.recording.update",
    "meeting_recorder.recording.delete",
    "meeting_recorder.recording.read_all",
    "meeting_recorder.recording.manage_all",
    "meeting_recorder.transcription.create",
    "meeting_recorder.telegram_member.read",
    "meeting_recorder.telegram_member.invite",
    "meeting_recorder.telegram_member.delete",
    "meeting_recorder.telegram_member.read_all",
    "meeting_recorder.telegram_member.manage_all",
    "meeting_recorder.settings.read",
    "meeting_recorder.settings.update",
    "meeting_recorder.storage.read"
  ],
  "menu": [
    {
      "title": "Meeting Recorder",
      "routeKey": "meeting_recorder.home",
      "path": "/app/p/meeting_recorder"
    }
  ]
}
