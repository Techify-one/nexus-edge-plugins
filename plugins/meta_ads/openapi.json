{
  "openapi": "3.1.0",
  "info": { "title": "Nexus Meta Ads API", "version": "2.0.0" },
  "paths": {
    "/accounts": {
      "get": {
        "summary": "List configured ad accounts",
        "responses": { "200": { "description": "Ad accounts" } }
      },
      "post": {
        "summary": "Add an ad account",
        "responses": { "201": { "description": "Created account" } }
      }
    },
    "/campaigns": {
      "get": {
        "summary": "List campaigns",
        "responses": { "200": { "description": "Campaigns" } }
      }
    },
    "/adsets": {
      "get": {
        "summary": "List ad sets",
        "responses": { "200": { "description": "Ad sets" } }
      }
    },
    "/ads": {
      "get": {
        "summary": "List ads",
        "responses": { "200": { "description": "Ads" } }
      }
    },
    "/insights": {
      "get": {
        "summary": "Read advertising insights",
        "responses": { "200": { "description": "Insights" } }
      }
    }
  }
}
