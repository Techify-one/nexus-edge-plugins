{
  "openapi": "3.1.0",
  "info": { "title": "Nexus Soletrando API", "version": "2.0.1" },
  "paths": {
    "/overview": {
      "get": {
        "summary": "Read spelling overview",
        "responses": { "200": { "description": "Overview" } }
      }
    },
    "/children": {
      "post": {
        "summary": "Create a child profile",
        "responses": { "201": { "description": "Created profile" } }
      }
    },
    "/children/{childId}": {
      "get": {
        "summary": "Read a child profile and progress",
        "responses": { "200": { "description": "Child profile" } }
      },
      "patch": {
        "summary": "Update a child profile",
        "responses": { "200": { "description": "Updated profile" } }
      },
      "delete": {
        "summary": "Delete a child profile",
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/play/{token}": {
      "get": {
        "summary": "Open a public spelling session",
        "responses": { "200": { "description": "Public session" } }
      }
    }
  }
}
